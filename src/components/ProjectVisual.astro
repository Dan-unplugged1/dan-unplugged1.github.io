---
// Abstract visuals for the case studies. These are deliberately wireframes and diagrams,
// not screenshots: replace them with real images of the work when they are available.
const { kind } = Astro.props;
// "raw" points for the data pipeline, laid out by a fixed pattern (no real data)
const raw = Array.from({ length: 28 }, (_, i) => ({ x: 22 + ((i * 37) % 96), y: 70 + ((i * 53) % 170), keep: i % 3 !== 1 }));
const kept = raw.filter((p) => p.keep);
---
{kind === 'web-a' && (
  <svg class="viz project-svg" viewBox="0 0 480 320" role="presentation">
    <path data-draw pathLength="1" d="M16 8 H464 a8 8 0 0 1 8 8 V304 a8 8 0 0 1 -8 8 H16 a8 8 0 0 1 -8 -8 V16 a8 8 0 0 1 8 -8 Z" />
    <path data-draw pathLength="1" class="faint" d="M8 44 H472" />
    <g data-pop><circle class="dot" cx="28" cy="26" r="4" /><circle class="dot" cx="44" cy="26" r="4" /><circle class="dot" cx="60" cy="26" r="4" /></g>
    <g data-pop class="shift"><rect class="bar strong" x="36" y="92" width="190" height="20" rx="4" /><rect class="bar strong" x="36" y="122" width="140" height="20" rx="4" /></g>
    <g data-pop><rect class="bar" x="36" y="164" width="200" height="8" rx="4" /><rect class="bar" x="36" y="182" width="170" height="8" rx="4" /></g>
    <rect data-pop class="cta" x="36" y="214" width="96" height="30" rx="15" />
    <g data-pop class="shift back"><rect class="frame" x="272" y="76" width="168" height="196" rx="10" /><path class="faint" d="M272 76 L440 272 M440 76 L272 272" /></g>
    <g data-pop><rect class="bar" x="300" y="22" width="36" height="8" rx="4" /><rect class="bar" x="348" y="22" width="36" height="8" rx="4" /><rect class="bar" x="396" y="22" width="36" height="8" rx="4" /></g>
  </svg>
)}
{kind === 'web-b' && (
  <svg class="viz project-svg" viewBox="0 0 480 320" role="presentation">
    <path data-draw pathLength="1" d="M16 8 H464 a8 8 0 0 1 8 8 V304 a8 8 0 0 1 -8 8 H16 a8 8 0 0 1 -8 -8 V16 a8 8 0 0 1 8 -8 Z" />
    <path data-draw pathLength="1" class="faint" d="M8 44 H472" />
    <g data-pop><circle class="dot" cx="28" cy="26" r="4" /><circle class="dot" cx="44" cy="26" r="4" /><circle class="dot" cx="60" cy="26" r="4" /></g>
    <g data-pop class="shift"><rect class="bar strong" x="130" y="74" width="220" height="20" rx="4" /><rect class="bar" x="160" y="106" width="160" height="8" rx="4" /></g>
    <rect data-pop class="cta" x="192" y="128" width="96" height="28" rx="14" />
    <g data-pop class="shift back"><rect class="frame" x="36" y="184" width="124" height="100" rx="10" /><circle class="ring" cx="98" cy="222" r="18" /><rect class="bar" x="62" y="256" width="72" height="8" rx="4" /></g>
    <g data-pop class="shift"><rect class="frame" x="178" y="184" width="124" height="100" rx="10" /><circle class="ring" cx="240" cy="222" r="18" /><rect class="bar" x="204" y="256" width="72" height="8" rx="4" /></g>
    <g data-pop class="shift back"><rect class="frame" x="320" y="184" width="124" height="100" rx="10" /><circle class="ring" cx="382" cy="222" r="18" /><rect class="bar" x="346" y="256" width="72" height="8" rx="4" /></g>
  </svg>
)}
{kind === 'data' && (
  <svg class="viz project-svg data" viewBox="0 0 480 320" role="presentation">
    {/* scrape: scattered raw points */}
    <g data-pop>{raw.map((p) => <circle class:list={['pt', { drop: !p.keep }]} cx={p.x} cy={p.y} r="3" />)}</g>
    {/* filter: a gate that only some points pass */}
    <path data-draw pathLength="1" d="M150 60 L196 130 V190 L150 260" />
    <path data-draw pathLength="1" d="M150 60 V260" class="faint" />
    <g data-pop>{kept.slice(0, 10).map((_, i) => <circle class="pt keep" cx={222 + (i % 2) * 16} cy={88 + i * 16} r="3" />)}</g>
    {/* model: a distribution fitted to what is left */}
    <path data-draw pathLength="1" class="faint" d="M276 262 H468" />
    <path data-draw pathLength="1" class="rise" d="M278 260 C320 258 338 84 372 84 S424 258 466 260" />
    <path data-draw pathLength="1" class="faint dashed" d="M372 84 V262" />
    <g class="flow"><circle class="packet" cx="120" cy="160" r="3.5" /><circle class="packet p2" cx="120" cy="160" r="3.5" /><circle class="packet p3" cx="120" cy="160" r="3.5" /></g>
    <text data-pop x="70" y="296" class="caption">scrape</text>
    <text data-pop x="196" y="296" class="caption">filter</text>
    <text data-pop x="372" y="296" class="caption">model</text>
  </svg>
)}

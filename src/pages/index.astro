---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site, nav, chapters, timeline, mind, lab, disciplines, projects, aspirations, closing, contact } from '../content/story';
import Chapter from '../components/Chapter.astro';
import PhoneSpark from '../components/PhoneSpark.astro';
import FoundationStack from '../components/FoundationStack.astro';
import VisionCurve from '../components/VisionCurve.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import Playground from '../components/Playground.astro';

const pageTitle = `${site.fullName} | ${site.title}`;
const year = new Date().getFullYear();
const hasContact = Boolean(contact.email) || contact.links.length > 0;
const pad = (n: number) => String(n).padStart(2, '0');
// which mind nodes a given node is linked to
const connected = (i: number) => mind.links.filter(([a, b]) => a === i || b === i).map(([a, b]) => (a === i ? b : a));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#050907" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
  </head>
  <body>
    <a class="skip" href="#curiosity">Skip to the story</a>
    <canvas id="scene" data-name={site.name} aria-hidden="true"></canvas>
    <div class="progress" aria-hidden="true"><span></span></div>

    <header class="top">
      <a class="mark" href="#top" aria-label={`${site.fullName}: back to the start`}>{site.fullName}<i aria-hidden="true"></i></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav class="site-nav" id="site-nav" aria-label="Chapters">
        {nav.map((n) => <a href={n.href} data-nav={n.section}>{n.label}</a>)}
        {hasContact && <a href="#contact" data-nav="contact">Contact</a>}
      </nav>
    </header>

    <main>
      {/* The hero is taller than the screen and pins its content, so scrolling through it drives the 3D transformation. */}
      <section class="hero" id="top" data-hero aria-labelledby="hero-h">
        <div class="hero-pin">
          <div class="anchor hero-anchor" data-3d="hero" aria-hidden="true"></div>
          <div class="hero-copy">
            <p class="eyebrow hero-in">{site.identity.map((part, i) => <>{i > 0 && <span class="sep" aria-hidden="true"> | </span>}<span>{part}</span></>)}</p>
            <h1 class="headline" id="hero-h">
              {site.headline.map((word, i) => <span class="hl" data-phase={i}><span>{word}</span> </span>)}
            </h1>
            <div class="hero-intro">
              <p class="hero-statement hero-in">{site.statement}</p>
              <p class="cta-row hero-in">
                {site.cta.map((c, i) => <a class:list={['btn', { primary: i === 0 }]} href={c.href}><span>{c.label}</span><i aria-hidden="true"></i></a>)}
              </p>
            </div>
          </div>
          <p class="scroll-hint" aria-hidden="true"><span>Scroll</span><i></i></p>
        </div>
      </section>

      <Chapter chapter={chapters.curiosity}>
        <div class="anchor" data-3d="engine" aria-hidden="true"></div>
      </Chapter>

      <Chapter chapter={chapters.spark} flip><PhoneSpark /></Chapter>

      <Chapter chapter={chapters.building}>
        <FoundationStack />
        <div slot="after" class="after">
          <div class="timeline">
            <span class="tl-line" aria-hidden="true"><span></span></span>
            <ol>
              {timeline.map((t) => (
                <li class="tl-item" data-reveal>
                  <p class="tl-when">{t.when}</p>
                  <h3>{t.title}</h3>
                  {t.roles && <ul class="roles">{t.roles.map((r) => <li>{r}</li>)}</ul>}
                  <p>{t.text}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </Chapter>

      {/* Inside My Mind: the 3D structure is drawn into the anchor; the list and panels are the same content as plain HTML. */}
      <Chapter chapter={chapters.mind}>
        <div class="mind-stage">
          <div class="anchor mind-anchor" data-3d="mind" data-names={JSON.stringify(mind.nodes.map((n) => n.name))} data-edges={JSON.stringify(mind.links)} aria-hidden="true">
            <span class="mind-label" data-mind-label hidden></span>
          </div>
          <p class="mind-hint" aria-hidden="true">{mind.hint}</p>
          <div class="mind-panels" aria-live="polite">
            {mind.nodes.map((n, i) => (
              <div class="mind-panel" data-mind-panel={i} hidden>
                <button type="button" class="mind-close" data-mind-close aria-label={`Close ${n.name}`}>Close <span aria-hidden="true">&times;</span></button>
                <p class="mind-panel-n">Node {pad(i + 1)}</p>
                <h3>{n.name}</h3>
                <p>{n.text}</p>
                <p class="mind-links">
                  <span>Connected to</span>
                  {connected(i).map((j) => <button type="button" data-mind-go={j}>{mind.nodes[j].name}</button>)}
                </p>
              </div>
            ))}
          </div>
        </div>
        <ul class="disciplines mind-list" slot="text">
          {mind.nodes.map((n, i) => (
            <li data-reveal>
              <button type="button" class="discipline" data-mind={i} aria-pressed="false">
                <span class="d-n" aria-hidden="true">{pad(i + 1)}</span>
                <span class="d-name">{n.name}</span>
                <span class="d-line">{n.text}</span>
              </button>
            </li>
          ))}
        </ul>
      </Chapter>

      <Chapter chapter={chapters.interests} flip>
        <div class="mind-stage">
          <div class="anchor lab-anchor" data-3d="lab" data-names={JSON.stringify(disciplines.map((d) => d.name))} aria-hidden="true">
            <span class="mind-label" data-lab-label hidden></span>
          </div>
          <p class="mind-hint" aria-hidden="true">{lab.hint}</p>
        </div>
        {/* The list is the lab overview. Opening an area swaps the list for that area's panel. */}
        <div class="lab-text" slot="text">
          <ul class="disciplines lab-list">
            {disciplines.map((d, i) => (
              <li data-reveal>
                <button type="button" class="discipline" data-lab={i}>
                  <span class="d-n" aria-hidden="true">{pad(i + 1)}</span>
                  <span class="d-name">{d.name}</span>
                  <span class="d-line">{d.line}</span>
                </button>
              </li>
            ))}
          </ul>
          <div class="lab-panels" aria-live="polite">
            {disciplines.map((d, i) => {
              const related = projects.filter((p) => d.projects.includes(p.id));
              const groups = (['used', 'learning', 'explore'] as const).filter((g) => d[g].length > 0);
              const prev = (i + disciplines.length - 1) % disciplines.length, next = (i + 1) % disciplines.length;
              return (
                <div class="mind-panel lab-panel" data-lab-panel={i} hidden>
                  <p class="mind-panel-n">Area {pad(i + 1)} of {pad(disciplines.length)}</p>
                  <h3 tabindex="-1">{d.name}</h3>
                  <p>{d.intro}</p>
                  {groups.length > 0 && (
                    <dl class="lab-groups">
                      {groups.map((g) => (
                        <div class={`lab-group ${g}`}><dt>{lab.groups[g]}</dt><dd>{d[g].map((item) => <span>{item}</span>)}</dd></div>
                      ))}
                    </dl>
                  )}
                  {related.length > 0 && (
                    <p class="mind-links"><span>Related work</span>{related.map((p) => <a href={`#${p.id}`}>{p.client}</a>)}</p>
                  )}
                  <div class="lab-nav">
                    <button type="button" data-lab-go={prev} aria-label={`Previous area: ${disciplines[prev].name}`}><span aria-hidden="true">&larr;</span> {disciplines[prev].name}</button>
                    <button type="button" class="back" data-lab-back>Back to the lab</button>
                    <button type="button" data-lab-go={next} aria-label={`Next area: ${disciplines[next].name}`}>{disciplines[next].name} <span aria-hidden="true">&rarr;</span></button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </Chapter>

      <Chapter chapter={chapters.playground}>
        <div slot="after" class="after"><Playground /></div>
      </Chapter>

      <Chapter chapter={chapters.projects}>
        <div slot="after" class="after projects">
          {projects.map((p, i) => (
            <article class:list={['project', { flip: i % 2 === 1 }]} id={p.id}>
              <div class="project-text">
                <p class="project-n" data-reveal>Project {pad(i + 1)}</p>
                <h3 data-reveal>{p.client}</h3>
                <p class="project-kind" data-reveal>{p.title}</p>
                <details class="case" data-reveal>
                  <summary><span class="when-closed">Open the case study</span><span class="when-open">Close the case study</span></summary>
                  <dl>
                    {p.overview && <div><dt>Overview</dt><dd>{p.overview}</dd></div>}
                    {p.objective && <div><dt>Objective</dt><dd>{p.objective}</dd></div>}
                    {p.role.length > 0 && <div><dt>My role</dt><dd>{p.role.join(' · ')}</dd></div>}
                    {p.tools.length > 0 && <div><dt>Tools and technologies</dt><dd>{p.tools.join(' · ')}</dd></div>}
                    {p.approach && <div><dt>My approach</dt><dd>{p.approach}</dd></div>}
                    {p.contributions.length > 0 && <div><dt>Key contributions</dt><dd><ul>{p.contributions.map((c) => <li>{c}</li>)}</ul></dd></div>}
                    {p.results && <div><dt>Results</dt><dd>{p.results}</dd></div>}
                  </dl>
                  {p.link && <a class="text-link" href={p.link} rel="noopener">Visit the project</a>}
                </details>
              </div>
              {p.image ? (
                <div class="project-media">
                  <figure class="shot" data-reveal>
                    <span class="shot-bar" aria-hidden="true"><i></i><i></i><i></i></span>
                    <img src={p.image} alt={p.imageAlt ?? `${p.client} website`} width="1920" height="920" loading="lazy" decoding="async"
                      style={`aspect-ratio:${p.imageRatio ?? '1920 / 920'}`} />
                  </figure>
                  {p.withDiagram && <div class="project-viz" aria-hidden="true"><ProjectVisual kind={p.visual} /></div>}
                </div>
              ) : (
                <div class="project-viz" aria-hidden="true"><ProjectVisual kind={p.visual} /></div>
              )}
            </article>
          ))}
        </div>
      </Chapter>

      <Chapter chapter={chapters.next} flip>
        <VisionCurve />
        <div slot="after" class="after">
          <p class="kicker aspire-label" data-reveal>I aspire to become</p>
          <ol class="aspire">
            {aspirations.map((a, i) => (
              <li data-reveal><span class="aspire-n">Direction {pad(i + 1)}</span><span class="aspire-t">{a}</span></li>
            ))}
          </ol>
          <p class="statement">
            {closing.statement.map((line, i) => <span class:list={['statement-line', { grad: i === 1 }]} data-reveal>{line} </span>)}
          </p>
        </div>
      </Chapter>

      <section class="finale stage" id="contact" data-section="contact" aria-label="Closing">
        <div class="stage-top"><p class="eyebrow" data-reveal>The story so far</p></div>
        <p class="stage-name name-fallback">{site.name}</p>
        <div class="stage-bottom">
          <p class="signoff" data-reveal>{closing.signoff}</p>
          {hasContact && <p class="kicker contact-label" data-reveal>Get in touch</p>}
          {hasContact && (
            <p class="contact" data-reveal>
              {contact.email && <a class="contact-mail" href={`mailto:${contact.email}`}>{contact.email}</a>}
              {contact.links.map((l) => <a class="text-link" href={l.href} rel="me noopener">{l.label}</a>)}
            </p>
          )}
          <p class="fine">&copy; {year} {site.fullName}</p>
        </div>
      </section>
    </main>

    <script>
      import '../scripts/motion.js';
      import '../scripts/playground.js';
      // The 3D scene is the heaviest part, so it loads after the words are on screen.
      import('../scripts/scene.js').catch((err) => {
        console.error(err);
        document.documentElement.classList.add('no-webgl');
      });
    </script>
  </body>
</html>
